    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --deep-slate: #1a1e23;
            --soft-accent: #708090;
            --white: #ffffff;
            --bg-light: #f8f9fa;
            --border: #e9ecef;
            --text-muted: #6c757d;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'Inter', Cambria, Cochin, Georgia, Times, 'Times New Roman', serif; background: var(--white); color: var(--deep-slate); line-height: 1.6; scroll-behavior: smooth; }

        /* --- NAVIGATION --- */
        nav {
            position: fixed; top: 0; width: 100%; height: 75px;
            background: rgba(26, 30, 35, 0.98); display: flex;
            justify-content: space-between; align-items: center;
            padding: 0 10%; z-index: 2000; backdrop-filter: blur(10px);
        }
        
        .nav-logo {
            display: flex;
            align-items: center;
            height: 100%;
        }


        .nav-logo img {
            height: 150px; 
            width: auto;  
            object-fit: contain;
            display: block;
       }
        .nav-links { display: flex; list-style: none; }
        .nav-links a { color: rgba(255, 255, 255, 0.8); text-decoration: none; margin-left: 25px; font-size: 0.85rem; text-transform: uppercase; transition: 0.3s; font-weight: 500; }
        .nav-links a:hover { color: var(--white); }

        /* --- HERO --- */
        .hero { height: 60vh; display: flex; align-items: center; justify-content: center; background: var(--bg-light); padding-top: 75px; }
        .hero-content { display: flex; align-items: center; gap: 60px; max-width: 1100px; }
        .profile-img { width: 280px; height: 280px; object-fit: cover; border-radius: 15px; box-shadow: 15px 15px 0px var(--deep-slate); }
        .hero-text h1 { font-family: Cambria, Cochin, Georgia, Times, 'Times New Roman', serif;  font-size: 3rem; line-height: 1.1; margin-bottom: 10px; }

        /* --- ABOUT ME (PERSONAL PROFILE) --- */
        #about { padding: 80px 10%; max-width: 1100px; margin: 0 auto; }
        .about-header { border-bottom: 2px solid var(--deep-slate); padding-bottom: 15px; margin-bottom: 40px; }
        .about-grid { display: grid; grid-template-columns: 1fr 2fr; gap: 50px; }
        
        .about-col-left h3 { font-size: 0.85rem; text-transform: uppercase; color: var(--soft-accent); letter-spacing: 1px; margin: 25px 0 10px; }
        .about-col-left p { font-size: 0.95rem; margin-bottom: 5px; }

        .about-entry { margin-bottom: 30px; position: relative; padding-left: 20px; border-left: 2px solid var(--border); }
        .about-entry h4 { font-size: 1.15rem; font-weight: 600; }
        .about-entry .sub { font-weight: 500; color: var(--soft-accent); display: block; margin-bottom: 8px; }
        .about-entry p { color: var(--text-muted); font-size: 0.95rem; }
        .honor-tag { background: #eee; font-size: 0.75rem; padding: 2px 8px; border-radius: 4px; font-weight: 600; text-transform: uppercase; }

        /* --- GALLERIES --- */
        .gallery-container { padding: 80px 10%; background: var(--bg-light); }
        .section-heading { margin-bottom: 35px; border-left: 5px solid var(--deep-slate); padding-left: 20px; }
        .academic-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 25px; margin-bottom: 60px; }
        
        .card { background: var(--white); border-radius: 10px; overflow: hidden; box-shadow: 0 5px 15px rgba(0,0,0,0.05); transition: 0.3s ease; border: 1px solid var(--border); }
        .card:hover { transform: translateY(-8px); }
        .card-img { height: 400px; background: #ddd; }
        .card-img img { width: 100%; height: 100%; object-fit: cover; }
        .card-info { font-family: 'Franklin Gothic Medium', 'Arial Narrow', Arial, sans-serif;   padding: 20px; }

        footer { background: var(--deep-slate); color: var(--white); padding: 50px 10%; text-align: center; }

        @media (max-width: 850px) {
            .hero-content { flex-direction: column; text-align: center; }
            .about-grid { grid-template-columns: 1fr; }
            .nav-links { display: none; }
        }
    </style>
</head>
